VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIRESTORE_EMULATOR=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=fake.firebaseapp.com

# Emulator is reached through the Vite dev-server same-origin proxy by default, so
# a host-side browser only needs the app port. Uncomment to connect directly
# instead, which requires the browser to resolve the compose service hostname.
# VITE_FIREBASE_EMULATOR_HOST=firebase