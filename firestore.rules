rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function globalRole() {
      return userData().role;
    }

    function isGlobalOwner() {
      return isSignedIn() && globalRole() == 'owner';
    }

    function isGlobalAdmin() {
      return isSignedIn() && globalRole() == 'admin';
    }

    function isWhitelisted() {
      let cfg = get(/databases/$(database)/documents/access_control/whitelist).data;
      return isSignedIn() &&
             request.auth.token.email.lower() in cfg.emails;
    }

    function householdRole(householdId) {
      let hm = get(/databases/$(database)/documents/households/$(householdId)).data;
      return hm.members[request.auth.uid].role;
    }

    function isHouseholdMember(householdId) {
      return householdRole(householdId) in ['member', 'admin', 'owner'];
    }

    function isHouseholdAdmin(householdId) {
      return householdRole(householdId) in ['admin', 'owner'];
    }

    match /access_control/{docId} {
      allow read: if isSignedIn() && (isGlobalOwner() || isGlobalAdmin() || isWhitelisted());
      allow write: if isSignedIn() && (isGlobalOwner() || isGlobalAdmin());
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (isGlobalOwner() || isGlobalAdmin());
    }

    match /households/{householdId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isHouseholdMember(householdId);

      match /members/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      // ---- Subcollections ----

      match /projects/{id} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /projects/{id}/snapshots/{sid} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /transactions/{transactionId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /accounts/{accountId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /accounts/{accountId}/snapshots/{sid} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /plannedIncomes/{pid} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /projectTransactions/{tid} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /portfolios/{portfolioId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /portfolios/{portfolioId}/snapshots/{sid} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /retirementPlans/{rpId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }

      match /reports/{reportId} {
        allow read: if isSignedIn() && isHouseholdMember(householdId);
        allow write: if isSignedIn() && isHouseholdAdmin(householdId);
      }
    }
  }
}
