rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isWhitelisted() {
      let cfg = get(/databases/$(database)/documents/access_control/whitelist).data;
      return isSignedIn() &&
             request.auth.token.email.lower() in cfg.emails;
    }

    function householdRole(householdId) {
      let hm = get(/databases/$(database)/documents/households/$(householdId)).data;
      return hm.members.get(request.auth.uid, { role: 'guest' }).role;
    }

    function isHouseholdMember(householdId) {
      return householdRole(householdId) in ['member', 'admin', 'owner'];
    }

    function isHouseholdAdmin(householdId) {
      return householdRole(householdId) in ['admin', 'owner'];
    }

    match /access_control/{docId} {
      allow read: if isSignedIn() && (isGlobalAdmin() || isWhitelisted());
      allow write: if isSignedIn() && isGlobalAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        isHouseholdAdmin(householdId) || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.members[request.auth.uid].role == 'guest'
        )
      );

      allow create: if isGlobalAdmin();
      allow delete: if isGlobalAdmin();

      // ---- Subcollections ----
      match /{allSubcollections=**} {
        allow read: if isHouseholdMember(householdId);
        allow write: if isHouseholdAdmin(householdId);
      }
    }
  }
}
